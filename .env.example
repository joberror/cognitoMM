# ========================================================================
#  CognitoMM — Environment Variables
# ========================================================================
#  Copy this file to .env and fill in your values.
#  cp .env.example .env
# ========================================================================

# --- Telegram API credentials (required) ---
# Get these from https://my.telegram.org/apps
API_ID=123456
API_HASH=your_api_hash_here

# --- Bot token (required) ---
# Get from @BotFather on Telegram
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# --- MongoDB connection (required) ---
# MongoDB Atlas URI or local mongodb://mongo:27017 (Docker Compose)
MONGO_URI=mongodb://localhost:27017
MONGO_DB=moviebot

# --- Admin user IDs (comma-separated) ---
# Telegram user IDs who get admin commands
ADMINS=123456789,987654321

# --- Optional: Log channel ID ---
# A Telegram channel/group ID (e.g. -1001234567890) for bot logs
# LOG_CHANNEL=-1001234567890

# --- Optional: TMDb API key ---
# For the movie request feature (https://developers.themoviedb.org/3)
# TMDB_API=your_tmdb_api_key

# --- Optional: Port for health-check web server ---
# Default 7860 (Hugging Face Spaces default)
# PORT=7860

# --- Optional: Self-keep-alive (managed hosts only) ---
# The bot pings its public URL to keep managed hosts (Hugging Face Spaces)
# from sleeping. On HF Spaces the URL is auto-derived from SPACE_HOST/SPACE_ID
# and the keep-alive should stay ENABLED. VPS/Docker hosts don't sleep, so it's
# disabled here by default - only set it to true if you run behind a custom
# domain/monitoring setup that needs the self-ping.
# ⚠️ HF Spaces: do NOT set KEEP_ALIVE_ENABLED=false in the Space's secrets.
KEEP_ALIVE_ENABLED=false
# KEEP_ALIVE_URL=https://your-domain.example/health
# KEEP_ALIVE_INTERVAL=240

# --- Optional: Broadcast settings ---
# BROADCAST_RATE_LIMIT=25
# BROADCAST_PROGRESS_INTERVAL=100
# BROADCAST_TEST_MODE=False
# BROADCAST_TEST_USERS=

# --- Optional: Bot behavior ---
# FUZZY_THRESHOLD=68
# AUTO_INDEXING=True
# SUPPORT_LINK=https://t.me/
# START_MESSAGE=Welcome to the bot! Use buttons below to navigate.
# Public Telegraph help guides. Set automatically by `make telegraph`
# (scripts/publish_telegraph.py). HELP_GUIDE_URL shows on every /help page;
# ADMIN_GUIDE_URL is an admin-only button on the admin help section.
# HELP_GUIDE_URL=https://telegra.ph/MovieBot--Help-Guide-10-04
# ADMIN_GUIDE_URL=https://telegra.ph/MovieBot--Admin-Guide-10-04

# --- Optional: Premium monetization (Telegram Stars) ---
# Stars invoices need no external payment provider. Plans are
# "key:days:stars" comma-separated. Disable purchases with
# PREMIUM_STARS_ENABLED=false.
# PREMIUM_STARS_ENABLED=true
# PREMIUM_PLANS=1m:30:50,3m:90:120,6m:180:200,12m:365:350
# Days-before-expiry at which reminder DMs are sent (smallest applicable).
# PREMIUM_EXPIRY_WARN_DAYS=3,1

# --- Optional: Daily download quota by tier (0 = unlimited) ---
# FREE_DOWNLOAD_DAILY_LIMIT=10
# PREMIUM_DOWNLOAD_DAILY_LIMIT=0

# --- Optional: Watchlist limits and behaviour ---
# Max titles per user by tier (admins get the premium cap).
# WATCHLIST_FREE_LIMIT=5
# WATCHLIST_PREMIUM_LIMIT=20
# Floodgate: within this window (seconds) a watcher gets ONE DM per title, so a
# full season indexing at once doesn't send a message per episode.
# WATCHLIST_NOTIFY_COOLDOWN_SECONDS=300
# Floor (seconds) between UPDATE presses on /watchlist (each re-checks every
# entry against TMDb/IMDb, so rapid taps are rate-limited).
# WATCHLIST_REFRESH_COOLDOWN_SECONDS=60
# Candidates shown in the /watch disambiguation picker.
# WATCHLIST_PICK_LIMIT=5
# How long a limited/premiere theatrical run counts as "In Cinemas".
# WATCHLIST_IN_CINEMAS_DAYS=21

# --- Optional: Auto-delete retention (minutes) by tier ---
# Delivered files are auto-deleted after this long (bulk deliveries longer).
# FILE_DELETION_MINUTES=5
# PREMIUM_FILE_DELETION_MINUTES=30
# BULK_FILE_DELETION_MINUTES=15
# PREMIUM_BULK_FILE_DELETION_MINUTES=60
# Lead time for the pre-deletion warning DM (scaled down if retention is short).
# FILE_DELETION_WARN_MINUTES=2
