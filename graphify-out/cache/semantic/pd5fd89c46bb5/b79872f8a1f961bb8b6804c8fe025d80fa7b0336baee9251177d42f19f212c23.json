{"nodes": [{"id": "deployment_deployment_guide", "label": "CognitoMM Deployment Guide", "file_type": "document", "source_file": "DEPLOYMENT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "deployment_docker_compose_stack", "label": "Docker Compose App plus MongoDB Stack", "file_type": "concept", "source_file": "DEPLOYMENT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "deployment_hugging_face_spaces_deployment", "label": "Hugging Face Spaces Deployment and GitHub Sync", "file_type": "concept", "source_file": "DEPLOYMENT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "deployment_keep_alive_self_ping", "label": "Self-Keep-Alive Rationale (HF Free-Tier Sleep)", "file_type": "rationale", "rationale": "Free HF Spaces pause after inactivity, which shows up as downtime, so the bot pings its own public /health URL every 240s (below the host's 15-minute sleep timer) while an external UptimeRobot monitor covers cold starts, since the self-ping cannot fire while the container is asleep. On VPS/Docker the ping is unnecessary, so .env.example ships KEEP_ALIVE_ENABLED=false.", "source_file": "DEPLOYMENT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "deployment_uptimerobot_monitoring", "label": "UptimeRobot Health and Metrics Monitors", "file_type": "concept", "source_file": "DEPLOYMENT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "deployment_session_file_persistence", "label": "Session File Peer-Cache Persistence", "file_type": "rationale", "rationale": "The .session file stores Telegram peer access hashes, so deleting it makes log sends fail with [403 PEER_ID_INVALID] until each peer re-resolves; run.sh keeps sessions by default and warm_up_peer()/flush() re-resolve on PeerIdInvalid instead of requiring an admin message.", "source_file": "DEPLOYMENT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "deployment_metrics_endpoint", "label": "Monitoring Endpoints (health, metrics, robots)", "file_type": "concept", "source_file": "DEPLOYMENT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "deployment_keep_alive_self_ping", "target": "codebase_notes_keepalive", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "DEPLOYMENT.md", "source_location": null, "weight": 1.0}, {"source": "deployment_metrics_endpoint", "target": "webhook_integration_betterstack_health_monitor", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DEPLOYMENT.md", "source_location": null, "weight": 1.0}, {"source": "deployment_deployment_guide", "target": "deployment_docker_compose_stack", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DEPLOYMENT.md", "source_location": null, "weight": 1.0}, {"source": "deployment_deployment_guide", "target": "deployment_hugging_face_spaces_deployment", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DEPLOYMENT.md", "source_location": null, "weight": 1.0}, {"source": "deployment_deployment_guide", "target": "deployment_uptimerobot_monitoring", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DEPLOYMENT.md", "source_location": null, "weight": 1.0}, {"source": "deployment_docker_compose_stack", "target": "docker_compose_app_service", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DEPLOYMENT.md", "source_location": null, "weight": 1.0}, {"source": "deployment_docker_compose_stack", "target":