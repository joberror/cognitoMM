#!/bin/sh
#
# Pre-commit hook: run the static re-export / broken-import / duplicate-def
# check (scripts/check_reexports.py) AND the version-bump gate
# (scripts/check_version_bump.py) before every commit.
#
# The version-bump gate fails a commit that adds a new feature (new command,
# new handler, new feature module) without bumping BOT_VERSION — run
# `make bump` first (see scripts/bump_version.py).
#
# Skips when no Python source in the scan targets (features/ or main.py) is
# staged, so doc-only/CI-only commits don't needlessly re-run the checks.
#
# Install (from the repo root):
#   git config core.hooksPath .githooks
# or
#   make install-hooks
#
# The hook is versioned here (git does NOT track .git/hooks), so the install
# step above must be run once per clone.

set -eu

# Repo root regardless of where the hook is invoked from.
ROOT="$(git rev-parse --show-toplevel)"

# Only run when anything under the scan targets (features/ or main.py) is
# staged. Pathspec 'features/' covers nested files too, matching the scanner's
# recursive glob (features/**/*.py).
if ! git diff --cached --name-only -- "features/" "main.py" | grep -q '\.py$'; then
    exit 0
fi

# Prefer the project virtualenv (.venv, holds pyroblack) like the Makefile
# does; fall back to the plain `python` on PATH.
if [ -x "$ROOT/.venv/bin/python" ]; then
    PY="$ROOT/.venv/bin/python"
else
    PY="python"
fi

echo "🔍 Running static check (re-export chains / broken imports / duplicates)..."
if ! (cd "$ROOT" && "$PY" scripts/check_reexports.py); then
    echo "❌ Pre-commit static check FAILED — fix the violations above before committing."
    echo '   (Hint: run make check to reproduce.)'
    exit 1
fi

echo "🔍 Running version-bump check (new feature -> BOT_VERSION bump)..."
if ! (cd "$ROOT" && "$PY" scripts/check_version_bump.py); then
    echo "❌ Pre-commit version-bump check FAILED — bump the version and re-stage before committing."
    echo '   (Hint: run make bump, then `git add features/config.py LATEST_RELEASE`.)'
    exit 1
fi

exit 0
