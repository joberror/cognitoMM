# Git
.git
.gitignore
.github/

# Python cache / bytecode
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.hypothesis/

# Environment
.env
.env.local
.env.*

# Session files
*.session
*.session-journal
*.session-wal
*.session-shm

# IDE / editors
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
logs/
*.log

# Documentation (not needed at runtime)
*.md
CODEBASE_NOTES.md
IMPLEMENTATION_SUMMARY.md
*.txt
# But requirements.txt MUST be in the build context (Dockerfile COPY step)
!requirements.txt
info/

# Agent config (not needed at runtime)
.agent/
.claude/
.context-engine/
.agents/

# Test files (not needed at runtime)
tests/
scripts/

# CI / Nix
.idx/
*.nix

# Docker
Dockerfile
docker-compose.yml
.dockerignore